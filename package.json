{
  "name": "lucky-lounge-demo",
  "version": "1.0.0",
  "private": true,
  "description": "A local, virtual-credit casino-style game demo.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "npm run tray",
    "server": "node server.js",
    "tray": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -STA -File ./scripts/lucky-lounge-tray.ps1",
    "dev": "node --watch server.js",
    "build:installer": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File ./installer/Build-Lucky-Lounge-Launcher.ps1",
    "test": "node --test"
  },
  "dependencies": {
    "babylonjs": "^9.38.0",
    "better-sqlite3": "^13.0.3",
    "phaser": "^4.2.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4"
  }
}
